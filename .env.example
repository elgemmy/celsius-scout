# Server-only. Never expose this as NEXT_PUBLIC_*.
FORTYGUARD_API_KEY=

# Required bearer token for the operator-only capture and status routes.
# Leaving it empty disables those routes even when the provider key is set.
FORTYGUARD_CAPTURE_TOKEN=

# Optional override for testing against a compatible endpoint.
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com

# Optional scout planner/explainer. If either value is absent, the app uses the
# deterministic scout without making an external request.
OPENAI_API_KEY=
OPENAI_MODEL=
