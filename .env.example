# Server-only. Never expose these as NEXT_PUBLIC_*.
# Copy to `.env` or `.env.local`. Next.js loads both; `.env.local` wins.
#
# Judges: fill the three OPENAI_* values from any Responses-API provider, then
# restart `npm run dev`. The Observed Phoenix snapshot is already in the repo;
# you do not need a FortyGuard key to run the scouting board.

FORTYGUARD_API_KEY=

# Required bearer token for the operator-only capture and status routes.
# Leaving it empty disables those routes even when the provider key is set.
FORTYGUARD_CAPTURE_TOKEN=

# Optional override for testing against a compatible endpoint.
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com

# Optional scout planner/explainer. If api key or model is absent, the app uses
# the deterministic scout without making an external request.
#
# The client speaks the OpenAI Responses API (`POST {base}/responses`), not Chat
# Completions. Any provider that implements Responses + function tools works:
# set key, model id, and SDK-style base URL (or the full /responses URL).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek:
# OPENAI_MODEL=deepseek-v4-flash
# OPENAI_BASE_URL=https://api.deepseek.com
#
# xAI / SpaceXAI:
# OPENAI_MODEL=grok-4.5
# OPENAI_BASE_URL=https://api.x.ai/v1
